   "source": [
    "import pandas as pd\n",
    "\n",
    "def eliminar_nulos(df):\n",
    "    \"\"\"Elimina filas con valores nulos.\"\"\"\n",
    "    df_sin_nulos = df.dropna()\n",
    "    return df_sin_nulos\n",
    "\n",
    "df = pd.read_csv(\"churn.csv\")\n",
    "\n",
    "df_limpio = eliminar_nulos(df)\n",
    "\n",
    "df_limpio.to_csv(\"churn_limpio.csv\", index=False)"
   ]
